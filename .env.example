# Copy this file to .env.local (which git ignores) and fill it in.
# These values stay on the server. They are never sent to the browser.
# On a host (e.g. Render), set the same names as environment variables there
# instead; do not upload this file.

# Switch the AI Imagination Director on. Leave it off to use the built-in rules.
AI_DIRECTOR=off

# Your Anthropic API key, from https://platform.claude.com/ (API keys).
# Using it makes paid API calls.
ANTHROPIC_API_KEY=

# Optional: the Claude model. The default is claude-haiku-5-5 (fast, low cost).
# AI_MODEL=claude-haiku-5-5

# Optional: the most AI calls allowed per day across all players (default 300).
# AI_DAILY_LIMIT=300

# Optional: explain each AI failure in the server log (npm run dev always does).
# AI_DEBUG=on
